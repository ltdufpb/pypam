[Unit]
Description=PyPAM - Online Python Editor
After=network.target docker.service
Requires=docker.service

[Service]
# Edit User, Group and the paths below: set them to the user that runs PyPAM
# and to the directory where PyPAM is installed.
Type=simple
User=username
Group=username
WorkingDirectory=/home/username/pypam
ExecStart=/home/username/pypam/.venv/bin/python pypam.py

# Self-Healing: Restart within 5 seconds if the process dies
Restart=always
RestartSec=5s

# Logging: Sent to Systemd Journal (view via journalctl)
StandardOutput=journal
StandardError=journal

# Ensure Python doesn't buffer logs
Environment=PORT=8000
Environment=HTTPS_ENABLED=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
